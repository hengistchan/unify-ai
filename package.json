{
  "name": "unify-ai",
  "version": "0.0.1",
  "private": true,
  "description": "Unified configuration management for AI agent tools",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @unify-ai/gui run electron:dev",
    "dev:core": "pnpm --filter @unify-ai/core run dev",
    "dev:cli": "pnpm --filter @unify-ai/cli run dev",
    "dev:gui": "pnpm --filter @unify-ai/gui run electron:dev",
    "build": "pnpm -r run build",
    "build:core": "pnpm --filter @unify-ai/core run build",
    "build:cli": "pnpm --filter @unify-ai/cli run build",
    "build:gui": "pnpm --filter @unify-ai/gui run build",
    "test": "pnpm --filter @unify-ai/core run test",
    "test:core": "pnpm --filter @unify-ai/core run test",
    "test:cli": "pnpm --filter @unify-ai/cli run test",
    "test:gui": "pnpm --filter @unify-ai/gui run test",
    "test:all": "pnpm -r run test"
  },
  "keywords": [
    "ai",
    "agent",
    "cursor",
    "claude",
    "copilot",
    "configuration",
    "unified"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
