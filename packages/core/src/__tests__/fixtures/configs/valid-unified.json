{
  "version": "1.0",
  "rules": [
    {
      "id": "rule-1",
      "name": "General Guidelines",
      "content": "Always write clean, maintainable code.",
      "alwaysApply": true
    },
    {
      "id": "rule-2",
      "name": "TypeScript Rules",
      "content": "Use strict type checking.",
      "globs": ["**/*.ts", "**/*.tsx"]
    }
  ],
  "mcp": {
    "servers": [
      {
        "name": "filesystem",
        "command": "mcp-server-filesystem",
        "args": ["--root", "./src"]
      }
    ]
  },
  "settings": {
    "model": {
      "default": "claude-3-opus"
    },
    "behavior": {
      "autoSave": true
    }
  }
}
