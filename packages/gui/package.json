{
  "name": "@unify-ai/gui",
  "version": "0.1.0",
  "description": "Electron + React GUI for unify-ai configuration management",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && node scripts/electron-dev.js\"",
    "dev:web": "vite",
    "build": "node scripts/build-electron.js && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && node scripts/electron-dev.js\"",
    "electron:dev:manual": "node scripts/build-electron.js && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "node scripts/build-electron.js && vite build && electron-builder",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@unify-ai/core": "workspace:*",
    "clsx": "^2.1.1",
    "electron": "^28.0.0",
    "lucide-react": "^0.564.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.1",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.24",
    "chokidar": "^5.0.0",
    "concurrently": "^8.2.0",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.27.3",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vitest": "^1.3.0",
    "wait-on": "^7.2.0"
  },
  "author": "unify-ai",
  "license": "MIT"
}
