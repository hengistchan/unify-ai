{
  "name": "unify-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Unified configuration management for AI agent tools",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "./scripts/dev.sh",
    "test": "pnpm --filter @unify-ai/core run test",
    "cli": "pnpm --filter @unify-ai/cli run dev",
    "gui": "pnpm --filter @unify-ai/gui run dev",
    "test:all": "pnpm -r run test",
    "build:all": "pnpm -r run build"
  },
  "keywords": [
    "ai",
    "agent",
    "cursor",
    "claude",
    "copilot",
    "configuration",
    "unified"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  }
}
