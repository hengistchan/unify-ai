{
  "name": "@unify-ai/core",
  "version": "0.0.2",
  "description": "Core library for unify-ai",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./discovery": {
      "import": "./dist/discovery/index.js",
      "types": "./dist/discovery/index.d.ts",
      "default": "./dist/discovery/index.js"
    },
    "./adapters": {
      "import": "./dist/adapters/index.js",
      "types": "./dist/adapters/index.d.ts",
      "default": "./dist/adapters/index.js"
    },
    "./converter": {
      "import": "./dist/converter/index.js",
      "types": "./dist/converter/index.d.ts",
      "default": "./dist/converter/index.js"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./model": {
      "import": "./dist/model/index.js",
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hengistchan/unify-ai.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/fix-esm-imports.js",
    "dev": "tsc --project tsconfig.build.json --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "glob": "^13.0.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
